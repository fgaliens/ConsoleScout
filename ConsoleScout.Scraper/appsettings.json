{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Scraper": {
    "idleMinutes": 60,
    "browser": {
      "channel": "chrome",
      "headless": true,
      "maxPages": 4,
      "navigationTimeoutSeconds": 30
    },
    "fetch": {
      "allowPrivateNetworks": false,
      "httpTimeoutSeconds": 20,
      "minHttpTextChars": 500
    }
  }
}
