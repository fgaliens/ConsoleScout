<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shown by a run without arguments; embedded because a published build has no README next to it. -->
    <EmbeddedResource Include="../README.md" LogicalName="ConsoleScout.README.md" />
    <None Update="appsettings.Debug.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ConsoleScout.Contracts/ConsoleScout.Contracts.csproj" />
    <!-- Build order only: the agent is a separate process, never loaded into this one. -->
    <ProjectReference Include="../ConsoleScout.Agent/ConsoleScout.Agent.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot" />
  </ItemGroup>

  <!-- Lets a Debug build find the agent's own output, so dotnet run needs no Agent:ExecutablePath. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AssemblyMetadata Include="AgentDevelopmentOutput" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ConsoleScout.Agent/bin/$(Configuration)/$(TargetFramework)/'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <!-- dotnet publish also publishes the agent, self-contained, into agent/ next to the CLI, where
       AgentLauncher looks for it. Self-contained, because the CLI needs no .NET runtime either. -->
  <Target Name="PublishAgent" AfterTargets="Publish">
    <!-- A separate dotnet publish rather than an MSBuild task: the agent has to be restored for this
         runtime identifier first, which needs an evaluation of its own. -->
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; publish &quot;$(MSBuildThisFileDirectory)../ConsoleScout.Agent/ConsoleScout.Agent.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained -nologo -o &quot;$([System.IO.Path]::GetFullPath('$(PublishDir)'))agent&quot;" />
  </Target>

  <!-- A short alias next to the executable: a symlink on macOS and Linux, a .cmd shim on Windows.
       Note that csc is also the name of the C# compiler (Mono, Visual Studio's Developer Prompt); whichever
       comes first on PATH wins. Change ShortAlias to pick another name. -->
  <PropertyGroup>
    <ShortAlias>csc</ShortAlias>
  </PropertyGroup>

  <Target Name="CreateShortAliasAfterBuild" AfterTargets="Build">
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="ln -sf $(AssemblyName) &quot;$(OutDir)$(ShortAlias)&quot;" />
    <WriteLinesToFile Condition="$([MSBuild]::IsOSPlatform('Windows'))" File="$(OutDir)$(ShortAlias).cmd"
                      Lines="@&quot;%~dp0$(AssemblyName).exe&quot; %*" Overwrite="true" />
  </Target>

  <Target Name="CreateShortAliasAfterPublish" AfterTargets="Publish">
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="ln -sf $(AssemblyName) &quot;$(PublishDir)$(ShortAlias)&quot;" />
    <WriteLinesToFile Condition="$([MSBuild]::IsOSPlatform('Windows'))" File="$(PublishDir)$(ShortAlias).cmd"
                      Lines="@&quot;%~dp0$(AssemblyName).exe&quot; %*" Overwrite="true" />
  </Target>

</Project>
