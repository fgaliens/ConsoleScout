{
  "models": {
    "main": {
      "endpoint": "https://api.example.ai/v1",
      "name": "smart-model",
      "maxToolRounds": 6,
      "flattenContentArrays": false
    },
    "summarizer": {
      "endpoint": "https://api.example.ai/v1",
      "name": "cheap-model",
      "flattenContentArrays": false
    }
  },
  "tools": {
    "webSearch": {
      "enabled": true,
      "providers": [ "duckduckgo", "google" ],
      "maxResults": 5
    },
    "webFetch": {
      "enabled": true,
      "maxChars": 8000,
      "maxBatchSize": 5,
      "maxBatchChars": 24000,
      "condense": true,
      "condensedMaxWords": 250
    }
  },
  "agent": {
    "autoStart": true,
    "startupTimeoutSeconds": 30,
    "requestTimeoutSeconds": 60
  },
  "preferences": {
    "answerLength": "normal"
  }
}
